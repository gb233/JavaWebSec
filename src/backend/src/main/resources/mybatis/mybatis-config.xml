<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Config 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-config.dtd">

<configuration>
    <!-- 全局设置 -->
    <settings>
        <!-- 开启驼峰命名转换 -->
        <setting name="mapUnderscoreToCamelCase" value="true"/>
        <!-- 开启延迟加载 -->
        <setting name="lazyLoadingEnabled" value="true"/>
        <!-- 开启二级缓存 -->
        <setting name="cacheEnabled" value="true"/>
        <!-- 开启日志 -->
        <setting name="logImpl" value="STDOUT_LOGGING"/>
    </settings>
    
    <!-- 类型别名 -->
    <typeAliases>
        <!-- 排除有冲突的实体类，使用具体的类名 -->
        <typeAlias type="com.javaweb.security.entity.Collection" alias="CollectionEntity"/>
        <typeAlias type="com.javaweb.security.entity.LanguagePreference" alias="LanguagePreference"/>
        <typeAlias type="com.javaweb.security.entity.UserGuidePreference" alias="UserGuidePreference"/>
        <typeAlias type="com.javaweb.security.entity.GuideStep" alias="GuideStep"/>
        <package name="com.javaweb.security.dto"/>
    </typeAliases>
    
    <!-- 插件配置 -->
    <plugins>
        <!-- 分页插件 -->
        <plugin interceptor="com.baomidou.mybatisplus.extension.plugins.MybatisPlusInterceptor">
            <property name="sqlParserType" value="mysql"/>
        </plugin>
    </plugins>
</configuration>

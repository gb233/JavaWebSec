# 环境变量示例文件
# 复制此文件为 .env.local 并修改相应的值

# 应用基础配置
VITE_APP_TITLE=Java Web安全教学系统
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# API配置
# ⚠️ 注意：代码中使用的是 VITE_API_BASE_URL，不是 VITE_APP_API_BASE_URL
# 开发环境：使用默认值 http://localhost:8080（在 request.ts 和 http.ts 中）
# 生产环境：需要设置 VITE_API_BASE_URL 环境变量
VITE_API_BASE_URL=http://localhost:8080
VITE_APP_API_BASE_URL=/api  # 已废弃，代码中未使用
VITE_APP_BASE_URL=/

# 功能开关
VITE_APP_MOCK=false
VITE_APP_DEBUG=true

# 文件上传配置
VITE_APP_UPLOAD_URL=/api/v1/files/upload

# WebSocket配置
VITE_APP_WS_URL=ws://localhost:8080/ws

# 开发环境特定配置
# VITE_APP_API_BASE_URL=http://localhost:8080/api
# VITE_APP_BASE_URL=http://localhost:3000
# VITE_APP_MOCK=true

# 生产环境特定配置
# VITE_APP_API_BASE_URL=https://api.yourdomain.com
# VITE_APP_BASE_URL=https://yourdomain.com
# VITE_APP_MOCK=false
# VITE_APP_DEBUG=false


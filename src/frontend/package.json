{
  "name": "security-teaching-frontend",
  "version": "1.0.0",
  "description": "Java Web安全教学系统前端",
  "author": "Java Web Security Team",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env SASS_SILENCE_DEPRECATIONS=legacy-js-api vite --host 0.0.0.0 --port 3000",
    "build": "cross-env SASS_SILENCE_DEPRECATIONS=legacy-js-api vite build",
    "build:prod": "vue-tsc && cross-env SASS_SILENCE_DEPRECATIONS=legacy-js-api vite build --mode production",
    "build:test": "vue-tsc && cross-env SASS_SILENCE_DEPRECATIONS=legacy-js-api vite build --mode test",
    "preview": "cross-env SASS_SILENCE_DEPRECATIONS=legacy-js-api vite preview --port 4173",
    "serve": "cross-env SASS_SILENCE_DEPRECATIONS=legacy-js-api vite preview --port 4173",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "lint:security": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --plugin security",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "analyze": "npx vite-bundle-analyzer",
    "clean": "rimraf dist node_modules/.vite",
    "reinstall": "npm run clean && npm install"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^10.6.1",
    "axios": "^1.6.2",
    "dayjs": "^1.11.10",
    "echarts": "^5.4.3",
    "element-plus": "^2.4.4",
    "highlight.js": "^11.9.0",
    "html2canvas": "^1.4.1",
    "js-cookie": "^3.0.5",
    "lodash-es": "^4.17.21",
    "marked": "^9.1.6",
    "mermaid": "^11.12.0",
    "monaco-editor": "^0.44.0",
    "nprogress": "^0.2.0",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.0",
    "qrcode": "^1.5.3",
    "sortablejs": "^1.15.1",
    "vue": "^3.3.8",
    "vue-echarts": "^6.6.1",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.152",
    "@playwright/test": "^1.40.1",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^20.10.5",
    "@types/nprogress": "^0.2.3",
    "@types/qrcode": "^1.5.5",
    "@types/sortablejs": "^1.15.7",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.3",
    "@vue/tsconfig": "^0.4.0",
    "cross-env": "^10.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.19.2",
    "jsdom": "^23.0.1",
    "mockjs": "^1.1.0",
    "playwright": "^1.40.1",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "sass-embedded": "^1.77.8",
    "terser": "^5.44.1",
    "typescript": "~5.2.2",
    "unplugin-auto-import": "^0.17.2",
    "unplugin-icons": "^0.18.1",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^8.1.0",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-mock": "^3.0.0",
    "vite-plugin-windicss": "^1.9.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^1.8.27",
    "windicss": "^3.5.6"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "engines": {
    "node": ">=20.18.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "vue3",
    "typescript",
    "vite",
    "element-plus",
    "security",
    "teaching",
    "owasp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/javaweb-security/teaching-system.git"
  },
  "bugs": {
    "url": "https://github.com/javaweb-security/teaching-system/issues"
  },
  "homepage": "https://github.com/javaweb-security/teaching-system#readme"
}

# ========================================
# 开发环境专用Dockerfile
# ========================================

FROM openjdk:17-jdk-slim

# 安装开发工具
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    vim \
    htop \
    mysql-client \
    && rm -rf /var/lib/apt/lists/*

# 安装Maven
RUN wget https://archive.apache.org/dist/maven/maven-3/3.9.5/binaries/apache-maven-3.9.5-bin.tar.gz \
    && tar -xzf apache-maven-3.9.5-bin.tar.gz -C /opt \
    && ln -s /opt/apache-maven-3.9.5 /opt/maven \
    && rm apache-maven-3.9.5-bin.tar.gz

# 设置环境变量
ENV MAVEN_HOME=/opt/maven
ENV PATH=$PATH:$MAVEN_HOME/bin

# 创建应用用户
RUN groupadd -r appuser && useradd -r -g appuser appuser

# 设置工作目录
WORKDIR /app

# 创建必要目录
RUN mkdir -p /app/logs /app/uploads \
    && chown -R appuser:appuser /app

# 复制Maven配置
COPY src/backend/pom.xml ./
COPY src/backend/.mvn/ .mvn/
COPY src/backend/mvnw ./

# 预下载依赖
RUN mvn dependency:go-offline -B

# 复制源码
COPY src/backend/src/ ./src/

# 暴露端口
EXPOSE 8080 5005

# 设置JVM调试参数
ENV JAVA_OPTS="-Xms256m -Xmx512m -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005"

# 切换用户
USER appuser

# 开发模式启动命令
CMD ["mvn", "spring-boot:run", "-Dspring-boot.run.jvmArguments=${JAVA_OPTS}"]

